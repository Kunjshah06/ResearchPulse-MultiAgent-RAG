# =============================================================================
# PaperMind AI — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=PaperMind AI
APP_VERSION=0.1.0
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-secret

# -----------------------------------------------------------------------------
# LLM Providers (only fill what you plan to use)
# -----------------------------------------------------------------------------
# Primary: Groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# OpenAI (optional fallback)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic (optional fallback)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (optional fallback)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash-exp

# Together AI (optional fallback)
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_DEFAULT_MODEL=meta-llama/Llama-3-70b-chat-hf

# Azure OpenAI (optional fallback)
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Active LLM provider: groq | openai | anthropic | google | together | azure
LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers   # sentence_transformers | openai | cohere
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu                        # cpu | cuda | mps

# -----------------------------------------------------------------------------
# Vector Database — Qdrant
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=                            # leave empty for local
QDRANT_COLLECTION_NAME=papermind_docs
QDRANT_USE_GRPC=false
QDRANT_PREFER_GRPC=false

# -----------------------------------------------------------------------------
# Knowledge Graph — Neo4j (optional, networkx used as fallback)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=papermind
USE_NEO4J=false                            # false → uses networkx in-memory graph

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
USE_REDIS=false                            # false → uses diskcache

# -----------------------------------------------------------------------------
# OCR Configuration
# -----------------------------------------------------------------------------
OCR_ENGINE=paddleocr                       # paddleocr | tesseract | auto
OCR_LANG=en
OCR_USE_GPU=false
TESSERACT_CMD=tesseract                    # path to tesseract binary if needed
OCR_CONFIDENCE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# Document Processing
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=100
SUPPORTED_FORMATS=pdf
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
CACHE_DIR=data/cache
EXPORTS_DIR=data/exports

# -----------------------------------------------------------------------------
# Layout Analysis
# -----------------------------------------------------------------------------
LAYOUT_MODEL=auto                          # auto | layoutparser | unstructured | rule_based
LAYOUT_CONFIDENCE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# Pipeline Configuration
# -----------------------------------------------------------------------------
PIPELINE_WORKERS=2
PIPELINE_TIMEOUT=300
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=2000

# -----------------------------------------------------------------------------
# Retrieval & RAG
# -----------------------------------------------------------------------------
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HYBRID_ALPHA=0.5                           # 0=BM25 only, 1=dense only, 0.5=balanced

# -----------------------------------------------------------------------------
# API Security
# -----------------------------------------------------------------------------
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                            # json | text
LOG_FILE=logs/papermind.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces
